# Technologies this project depends on. Kept by security-advisor (dev_team),
# read by cve-watch. Package dependencies come from the lockfiles; list here
# only what they don't cover.
schema = 1
updated = 2026-11-22

[stack]
languages = ["TypeScript 6.0"]
frameworks = ["Vue 3.5", "VexFlow 5.0"]
runtime = ["Node.js 22 (build, dev)", "nginx 1.30 (serves the static build in production)"]
tooling = ["Vite 8.3", "vite-plugin-pwa 1.3", "Tailwind CSS 4.3", "Vitest 5.0", "Playwright 1.63", "ESLint 10.11", "vue-tsc 3.3"]
deployment = ["Docker multi-stage image (node:22-alpine build, nginxinc/nginx-unprivileged:1.30-alpine runtime)", "Docker Compose, built on the VPS with --pull", "behind the VPS's shared Caddy (~/caddy, caddy:2-alpine, common to every app on the VPS, over the network caddy_infinite-flow; not ours, not pinned here)", "VPS host x86_64"]
lockfiles = ["package-lock.json"]

# Runtime versions below are those of the nginx 1.30 image the Dockerfile
# resolves to. The nginx 1.30 move (48be99a) was merged into main on
# 2026-10-26 (316199d) and is in v3.2.0 and v3.3.0. The owner deployed main
# 6958001 (which carries it) around 2026-10-28 (session notes; not verified on
# the VPS), so production most likely runs 1.30.6; it runs nginx 1.28.2,
# OpenSSL 3.5.5, Alpine 3.23.3 only if no deploy happened since 2026-10-26
# (read-only check of that date). `scripts/vps.sh status` shows the deployed
# commit. The VPS host is x86_64 (32-bit-only advisories such as OpenSSL
# CVE-2026-31789 do not apply) and builds with `docker compose build --pull`.
#
# Registry move (checked 2026-11-22): upstream publishes nginx-unprivileged
# releases after 1.30.6 / 1.31.7 only under Docker Hub `nginx/nginx-unprivileged`
# (also ghcr.io/nginx/nginx-unprivileged). The old `nginxinc/` namespace the
# Dockerfile names is frozen at 1.30.6 (last push 2026-10-19), so a rebuild
# with --pull no longer picks up 1.30.x fixes. nginx/nginx-unprivileged:1.30-alpine
# is 1.30.7 (digest 0c53a1f2..., 2026-11-18, Alpine 3.24.4, uid 101, :8080).

# Production web server: the only component that runs in production. It serves
# dist/ as static files on :8080, behind the VPS's TLS-terminating Caddy.
[[platform]]
name = "nginx"
version = "1.30.6"
cpe = "cpe:2.3:a:f5:nginx_open_source"
source = "Dockerfile runtime stage FROM nginxinc/nginx-unprivileged:1.30-alpine (floating minor tag on a frozen namespace: still 1.30.6, digest f5116ed4..., image of 2026-10-19, checked on Docker Hub 2026-11-22). Rebuilds do NOT pick up later 1.30.x: the fixed image is nginx/nginx-unprivileged:1.30-alpine (1.30.7). Production: probably 1.30.6 (deploy of main 6958001 about 2026-10-28, not verified), 1.28.2 if not deployed since 2026-10-26"

# OS of the runtime image (shipped). apk packages are not scanned by cve-watch:
# on 2026-10-26 OSV Alpine:v3.24 listed zlib 1.3.2-r0 (CVE-2026-85091, gzFile
# API, not used by nginx's deflate-stream gzip) and curl/libcurl 8.22.0-r0
# (24 advisories, curl unused at runtime; healthcheck uses busybox wget), both
# fixed in the v3.24 repo (zlib 1.3.2-r1, curl 8.23.0-r0), arriving with the
# next upstream rebuild of the tag. musl 1.2.6-r2, pcre2 10.49-r0, busybox
# 1.37.0-r31 had none.
[[platform]]
name = "Alpine Linux"
version = "3.24.2"
cpe = "cpe:2.3:o:alpinelinux:alpine_linux"
source = "base of nginxinc/nginx-unprivileged:1.30-alpine (/etc/alpine-release, read offline 2026-10-26; tag frozen since 2026-10-19, see the registry note above). Production: probably the same, 3.23.3 if not deployed since 2026-10-26. nginx/nginx-unprivileged:1.30-alpine is on 3.24.4"

# TLS library in the runtime image (libssl3/libcrypto3). nginx listens in plain
# HTTP on :8080; TLS is terminated by Caddy, so nginx does not use it for TLS.
[[platform]]
name = "OpenSSL"
version = "3.5.9"
cpe = "cpe:2.3:a:openssl:openssl"
source = "apk libssl3/libcrypto3 3.5.9-r0 in nginxinc/nginx-unprivileged:1.30-alpine (read offline 2026-10-26; tag frozen since 2026-10-19). Production: probably the same, 3.5.5 if not deployed since 2026-10-26"

# Build stage only: runs `npm ci` and `vite build`, never shipped.
[[platform]]
name = "Node.js (Docker build stage)"
version = "22.23.4"
cpe = "cpe:2.3:a:nodejs:node.js"
source = "Dockerfile build stage FROM node:22-alpine (floating tag; Docker Hub tag = 22.23.4-alpine since 2026-10-22, Alpine 3.24). The VPS builds with --pull (branch nginx-1.30), so it gets the current tag; the locally cached node:22-alpine is still 22.23.3 (2026-09-23). package.json engines: >=22.12.0"

# Developer machine: runs the Vite dev server, Vitest, Playwright.
[[platform]]
name = "Node.js (dev host)"
version = "22.23.4"
cpe = "cpe:2.3:a:nodejs:node.js"
source = "host (node --version on the Linux dev machine)"

# Dev container (optional dev environment).
[[platform]]
name = "Node.js (devcontainer)"
version = "22.23.4"
cpe = "cpe:2.3:a:nodejs:node.js"
source = ".devcontainer/Dockerfile FROM mcr.microsoft.com/devcontainers/typescript-node:22-bookworm (floating tag; image of 2026-10-28, pulled 2026-11-04, NODE_VERSION 22.23.4). No infinite_flow devcontainer is built locally yet: the next build uses this base"

# Accepted risk: deepmerge prototype poisoning, build-time only, no fix exists.
# Review earlier if deepmerge publishes a release > 4.3.1 or
# @rollup/plugin-node-resolve stops depending on it.
[[ignore]]
id = "GHSA-gcqx-w48m-w2h4"
package = "npm/deepmerge"
reason = "build-time only (vite-plugin-pwa -> workbox-build -> @rollup/plugin-node-resolve, during vite build), not shipped in dist/; the plugin only merges its own constant defaults, no outside object; no fixed version exists (4.3.1 is the latest). Revisit when deepmerge > 4.3.1 or node-resolve drops it"
approved_by = "bastien (owner, 2026-11-04, relayed by the coordinator)"
until = 2027-02-04
