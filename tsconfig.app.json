{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "tests/unit/**/*.ts",
    "tests/perf/**/*.ts",
    "tests/sweep/**/*.ts",
    "tests/sweep-my-instrument/**/*.ts",
    "tests/e2e/notation-harness/**/*.ts",
    "tests/e2e/notation-harness-window.d.ts",
    "tests/e2e/workspace-harness/**/*.ts",
    "tests/e2e/workspace-harness-window.d.ts"
  ],
  "exclude": [
    "tests/unit/boundaries/**",
    "tests/unit/code-health/**",
    "tests/unit/scripts/build-commit.spec.ts"
  ]
}
